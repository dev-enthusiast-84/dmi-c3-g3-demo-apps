#!/bin/bash

# ============================================
# DATABASE INITIALIZATION TEMPLATE
# ============================================
#
# OPTIONAL: Pre-initialize database before EC2 deployment
#
# INSTRUCTIONS:
# 1. Copy this file: cp database-init.sh.template database-init.local.sh
# 2. Edit database-init.local.sh with YOUR RDS credentials
# 3. Run: bash database-init.local.sh
# 4. Do NOT commit database-init.local.sh to git
#
# This script is OPTIONAL. The application will auto-create
# tables when it starts, so this is just for optimization.
#

set -e

# ============================================
# EDIT THESE VALUES WITH YOUR RDS CREDENTIALS
# ============================================

DB_TYPE="postgres"                              # postgres or mysql
DB_ENDPOINT="your-rds-endpoint.rds.amazonaws.com"
DB_USER="your-rds-username"
DB_PASSWORD="your-rds-password"
DB_NAME="ha-tt-db"
DB_PORT="5432"                                  # 5432 (postgres) or 3306 (mysql)

# ============================================
# DO NOT EDIT BELOW THIS LINE
# ============================================

echo "=== Database Initialization Script ==="
echo "Database Type: $DB_TYPE"
echo "Endpoint: $DB_ENDPOINT"
echo "User: $DB_USER"
echo "Database: $DB_NAME"
echo ""

if [ "$DB_TYPE" = "postgres" ]; then
  echo "Initializing PostgreSQL database..."

  # Check if psql is available
  if ! command -v psql &> /dev/null; then
    echo "Installing PostgreSQL client..."
    apt-get update
    apt-get install -y postgresql-client
  fi

  # Set connection environment
  export PGPASSWORD="$DB_PASSWORD"

  # Create database
  echo "Creating database: $DB_NAME"
  psql -h "$DB_ENDPOINT" -U "$DB_USER" -p "$DB_PORT" -c "CREATE DATABASE $DB_NAME;" 2>/dev/null || true

  # Create table
  echo "Creating table: hits"
  psql -h "$DB_ENDPOINT" -U "$DB_USER" -d "$DB_NAME" -p "$DB_PORT" <<EOF
CREATE TABLE IF NOT EXISTS hits (
  id SERIAL PRIMARY KEY,
  hit_count INT DEFAULT 0,
  last_hit TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

INSERT INTO hits (hit_count) VALUES (0)
ON CONFLICT DO NOTHING;

SELECT COUNT(*) as row_count FROM hits;
EOF

  echo "✓ PostgreSQL initialization complete"

elif [ "$DB_TYPE" = "mysql" ]; then
  echo "Initializing MySQL database..."

  # Check if mysql is available
  if ! command -v mysql &> /dev/null; then
    echo "Installing MySQL client..."
    apt-get update
    apt-get install -y mysql-client
  fi

  # Create database
  echo "Creating database: $DB_NAME"
  mysql -h "$DB_ENDPOINT" -u "$DB_USER" -p"$DB_PASSWORD" <<EOF 2>/dev/null || true
CREATE DATABASE IF NOT EXISTS $DB_NAME;
EOF

  # Create table
  echo "Creating table: hits"
  mysql -h "$DB_ENDPOINT" -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" <<EOF
CREATE TABLE IF NOT EXISTS hits (
  id INT AUTO_INCREMENT PRIMARY KEY,
  hit_count INT DEFAULT 0,
  last_hit TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

INSERT IGNORE INTO hits (id, hit_count) VALUES (1, 0);

SELECT COUNT(*) as row_count FROM hits;
EOF

  echo "✓ MySQL initialization complete"

else
  echo "✗ Unsupported database type: $DB_TYPE"
  echo "Supported: postgres, mysql"
  exit 1
fi

echo ""
echo "=== Database Ready ==="
echo "Database: $DB_NAME"
echo "Table: hits"
echo ""
echo "You can now run the EC2 user data script with this database."
