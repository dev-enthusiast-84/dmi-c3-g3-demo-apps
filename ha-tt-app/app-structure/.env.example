# Application Configuration
APP_PORT=8000
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration
# Choose: postgres or mysql
DB_TYPE=postgres

# Database Connection Details
DB_ENDPOINT=your-database-endpoint.rds.amazonaws.com
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=ha-tt-db
DB_PORT=5432

# For MySQL, use these values instead:
# DB_TYPE=mysql
# DB_USER=admin
# DB_PORT=3306
