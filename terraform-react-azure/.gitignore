# Local Terraform working directory (providers, modules cache)
.terraform/

# State files can contain secrets such as the VM admin password in plain text
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files may hold secrets; commit only the example file
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.example.json

# Crash logs and local override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config and plan output
.terraformrc
terraform.rc
*.tfplan

# OS and editor files
.DS_Store

# Note: .terraform.lock.hcl is intentionally NOT ignored; commit it so provider versions are pinned.
